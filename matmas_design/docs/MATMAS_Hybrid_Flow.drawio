try></mxCell><mxCell id="p1_w2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.6000000000000001;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_S3" target="p1_S6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_w3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_S3" target="p1_S7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_w9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_S3" target="p1_S2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="250" height="198" as="geometry"/></mxCell><mxCell id="p1_lg0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt0" value="IDMC step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="28" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt1" value="Notebook step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="52" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg2" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt2" value="SQL procedure" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="76" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg3" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt3" value="SQL table / view" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="100" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg4" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="126" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt4" value="OneLake folder" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="124" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg5" value="" style="rounded=0;html=1;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="150" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt5" value="Decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="148" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_lg6" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p1_legend"><mxGeometry x="10" y="174" width="30" height="16" as="geometry"/></mxCell><mxCell id="p1_lgt6" value="Error folder" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="p1_legend"><mxGeometry x="50" y="172" width="190" height="20" as="geometry"/></mxCell><mxCell id="p1_note" value="&lt;b&gt;Solid arrow&lt;/b&gt; = writes / moves &amp;nbsp;&amp;nbsp; &lt;b&gt;Dashed arrow&lt;/b&gt; = reads / reconcile" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="1300" width="600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 Notebook logic"><mxGraphModel dx="1600" dy="2760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b&gt;nb_matmas_process: what happens in the code, step by step&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p2_sub" value="Section numbers match the notebook. Right: what each step reads (blue) or updates (green)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p2_start" value="&lt;b&gt;Scheduled run&lt;/b&gt; (every 15 min)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="220" height="50" as="geometry"/></mxCell><mxCell id="p2_conn" value="&lt;b&gt;§2 connect&lt;/b&gt;&lt;br&gt;connect_to_artifact('sqldb-p2o-intg-dev')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_cfg" value="&lt;b&gt;§3 load config&lt;/b&gt;&lt;br&gt;settings + active routes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_ncfg" value="&lt;b&gt;READ&lt;/b&gt; cfg.matmas_setting: onelake_root&lt;br&gt;→ /lakehouse/default/Files/erp_to_matmas/landing&lt;br&gt;&lt;b&gt;READ&lt;/b&gt; cfg.matmas_route_config (active_flag = 1): route_id, onelake_folder,&lt;br&gt;target table, load_operation, start/end date values" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="280" width="460" height="80" as="geometry"/></mxCell><mxCell id="p2_route" value="&lt;b&gt;For each route&lt;/b&gt;&lt;br&gt;folder landing/&amp;lt;onelake_folder&amp;gt; (e.g. JDE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_adopt" value="&lt;b&gt;§4 adopt loose files&lt;/b&gt;&lt;br&gt;file dropped straight into landing/JDE/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_nadopt" value="&lt;b&gt;MOVE (OneLake)&lt;/b&gt; landing/JDE/file&lt;br&gt;→ landing/JDE/&lt;b&gt;NB&amp;lt;yyyymmddhhmmss&amp;gt;&lt;/b&gt;/file" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecf6ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="460" height="60" as="geometry"/></mxCell><mxCell id="p2_sweep" value="&lt;b&gt;§4 sweep run folders&lt;/b&gt;&lt;br&gt;landing/JDE/&amp;lt;RUN_ID&amp;gt;/ (skip _design); oldest first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_stable" value="&lt;b&gt;All files stable?&lt;/b&gt;&lt;br&gt;unchanged 20 s&lt;br&gt;(or after a 20 s recheck)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="260" height="100" as="geometry"/></mxCell><mxCell id="p2_wstable" value="&lt;b&gt;Wait&lt;/b&gt;: files stay in landing,&lt;br&gt;next sweep checks again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="715" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2_lock" value="&lt;b&gt;§6a lock route&lt;/b&gt;&lt;br&gt;sp_getapplock matmas_&amp;lt;route_id&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="850" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_wlock" value="&lt;b&gt;Skip&lt;/b&gt;: another run is loading this route" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="845" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_nlock" value="&lt;b&gt;SQL session lock&lt;/b&gt; (released at the end of the run folder)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="860" width="460" height="40" as="geometry"/></mxCell><mxCell id="p2_resume" value="&lt;b&gt;Already LOADED / FAILED&lt;/b&gt;&lt;br&gt;for this run in run_log?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="260" height="100" as="geometry"/></mxCell><mxCell id="p2_nresume" value="&lt;b&gt;READ&lt;/b&gt; matmas.run_log events for run_id + route_id&lt;br&gt;(yes = an earlier run stopped before the move: move only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="965" width="460" height="60" as="geometry"/></mxCell><mxCell id="p2_coll" value="&lt;b&gt;IDMC COLLECTED logged?&lt;/b&gt;&lt;br&gt;(NB folder, or older than 60 min = yes)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="1100" width="260" height="100" as="geometry"/></mxCell><mxCell id="p2_wcoll" value="&lt;b&gt;Wait&lt;/b&gt;: IDMC is still copying&lt;br&gt;this run's files" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1115" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2_ncoll" value="&lt;b&gt;READ&lt;/b&gt; matmas.run_log: event COLLECTED for this run_id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1130" width="460" height="40" as="geometry"/></mxCell><mxCell id="p2_parse" value="&lt;b&gt;§5 parse&lt;/b&gt;&lt;br&gt;6 fields by position + start_date / end_date" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="1250" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_nparse" value="start_date = start_date_value or today, end_date = end_date_value or 9999-12-31&lt;br&gt;blank rows skipped; a row without 6 fields → reject row" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1250" width="460" height="60" as="geometry"/></mxCell><mxCell id="p2_file" value="&lt;b&gt;File usable?&lt;/b&gt;&lt;br&gt;not empty, header has 6 columns" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="1350" width="260" height="100" as="geometry"/></mxCell><mxCell id="p2_ffile" value="&lt;b&gt;LOAD_FAILED&lt;/b&gt; (file cannot be read)&lt;br&gt;outcome = ERROR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1365" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2_stage" value="&lt;b&gt;§6e stage&lt;/b&gt;&lt;br&gt;delete leftovers, insert stage + rejects" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="1500" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_nstage" value="&lt;b&gt;DELETE&lt;/b&gt; matmas.material_master_stage (stage_status NEW, this run)&lt;br&gt;&lt;b&gt;INSERT&lt;/b&gt; matmas.material_master_stage: run_id, route_id, source_file_name,&lt;br&gt;6 fields, start_date, end_date (stage_status NEW)&lt;br&gt;&lt;b&gt;INSERT&lt;/b&gt; matmas.material_master_reject: rows with a wrong field count" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecf6ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1480" width="460" height="100" as="geometry"/></mxCell><mxCell id="p2_ins" value="&lt;b&gt;Insert OK?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="1610" width="260" height="90" as="geometry"/></mxCell><mxCell id="p2_fins" value="&lt;b&gt;LOAD_RETRY&lt;/b&gt; attempt n of 5: files stay in landing&lt;br&gt;5th failure: &lt;b&gt;LOAD_FAILED&lt;/b&gt;, outcome = ERROR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1620" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2_apply" value="&lt;b&gt;§6f EXEC matmas.sp_apply_route&lt;/b&gt;&lt;br&gt;validate keys + lengths, skip duplicate file,&lt;br&gt;de-duplicate, run the route's operation&lt;br&gt;(one transaction)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="1750" width="300" height="100" as="geometry"/></mxCell><mxCell id="p2_napply" value="&lt;b&gt;INSERT&lt;/b&gt; matmas.material_master_reject: missing key / too long&lt;br&gt;&lt;b&gt;INSERT / MERGE / UPDATE / DELETE&lt;/b&gt; matmas.&amp;lt;erp&amp;gt;_material_master&lt;br&gt;&amp;nbsp;&amp;nbsp;(load_operation; start_date kept on update)&lt;br&gt;&lt;b&gt;INSERT&lt;/b&gt; matmas.file_history: SHA-256 fingerprint of each file&lt;br&gt;&lt;b&gt;UPDATE&lt;/b&gt; material_master_stage.stage_status: APPLIED / REJECTED / DUPLICATE&lt;br&gt;&lt;b&gt;INSERT&lt;/b&gt; matmas.run_log: LOADED (counts), DUPLICATE_FILE&lt;br&gt;on error: rollback, stage rows FAILED, &lt;b&gt;APPLY_FAILED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecf6ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1720" width="460" height="160" as="geometry"/></mxCell><mxCell id="p2_outc" value="&lt;b&gt;§6g outcome&lt;/b&gt;&lt;br&gt;matmas.v_run_outcome: ARCHIVE / DUPLICATE / ERROR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="1950" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_noutc" value="&lt;b&gt;READ&lt;/b&gt; matmas.v_run_outcome (from this run's run_log events)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef3fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1960" width="460" height="40" as="geometry"/></mxCell><mxCell id="p2_move" value="&lt;b&gt;§6h move + log&lt;/b&gt;&lt;br&gt;landing → archive | duplicate | error /JDE/&amp;lt;RUN_ID&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="2050" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2_nmove" value="&lt;b&gt;MOVE (OneLake)&lt;/b&gt; every file of the run folder, landing folder removed&lt;br&gt;&lt;b&gt;INSERT&lt;/b&gt; matmas.run_log: OUTCOME (file_count, file names)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecf6ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="2055" width="460" height="60" as="geometry"/></mxCell><mxCell id="p2_more" value="&lt;b&gt;More run folders&lt;/b&gt;&lt;br&gt;in this route?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="2170" width="260" height="90" as="geometry"/></mxCell><mxCell id="p2_recon" value="&lt;b&gt;§7 reconcile&lt;/b&gt;&lt;br&gt;error/JDE/&amp;lt;RUN_ID&amp;gt; whose last load event is LOADED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="2310" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_nrecon" value="after a fix + EXEC matmas.sp_reapply_run:&lt;br&gt;&lt;b&gt;MOVE (OneLake)&lt;/b&gt; error → archive, &lt;b&gt;INSERT&lt;/b&gt; run_log OUTCOME (after reapply)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecf6ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="2310" width="460" height="60" as="geometry"/></mxCell><mxCell id="p2_moreR" v